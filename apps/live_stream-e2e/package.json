{
  "name": "@live-stream/live_stream-e2e",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "implicitDependencies": [
      "@live-stream/live_stream"
    ],
    "targets": {
      "e2e": {
        "executor": "@nx/jest:jest",
        "outputs": [
          "{projectRoot}/test-output/jest/coverage"
        ],
        "options": {
          "jestConfig": "apps/live_stream-e2e/jest.config.cts",
          "passWithNoTests": true
        },
        "dependsOn": [
          "@live-stream/live_stream:build",
          "@live-stream/live_stream:serve"
        ]
      }
    }
  }
}
